# Copy values from the repo-root `.env` / `.env.example`.
# Vite loads the root `.env` via `envDir` in vite.config.ts.
# The callback server also loads `../../.env` on startup.

# FRONTEND_PORT=5173
# CALLBACK_PORT=8000
# VITE_API_BASE_URL=http://localhost:3000
# VITE_CALLBACK_URL=http://localhost:8000/api/crawl-results
