{
  "name": "webcrawler",
  "version": "1.0.0",
  "description": "Cyber Crawler Backend — puppeteer-powered web scraping with real-time monitoring",
  "main": "main.ts",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "install:browser": "puppeteer browsers install chrome",
    "postinstall": "puppeteer browsers install chrome"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "body-parser": "^1.20.3",
    "express": "^4.18.2",
    "express-handlebars": "^7.1.2",
    "jimp": "^1.6.1",
    "pg": "^8.14.0",
    "puppeteer": "^22.0.0",
    "socket.io": "^4.7.4",
    "tesseract.js": "^7.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.11",
    "@types/node": "^20.11.0",
    "nodemon": "^3.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^2.1.8"
  }
}
