# Preferred ports for Spyber Man sub-systems
BACKEND_PORT=3000
FRONTEND_PORT=5173
CALLBACK_PORT=8000

# Backend (Express / SpyberMan) — reads PORT
PORT=3000

# Front-end UI display URL and absolute callback URL embedded in crawl requests.
# Keep these aligned with BACKEND_PORT / CALLBACK_PORT above.
VITE_API_BASE_URL=http://localhost:3000
VITE_CALLBACK_URL=http://localhost:8000/api/crawl-results
