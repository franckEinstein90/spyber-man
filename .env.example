# Port manager is optional; leave blank to use the fixed ports below.
PORT_MANAGER_API_URL=

# Node crawler. Crawl callbacks are accepted on this same service.
BACKEND_PORT=3000

# Chat UI
FRONTEND_PORT=5173

# Embedded Postgres (PGlite) with pgvector. Data files live in data/pgdata.
POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Cohere Parse. Used to turn crawl screenshots into markdown.
# https://docs.cohere.com/docs/parse
COHERE_API_KEY=

# URLs shared by the MCP server
CRAWLER_BACKEND_URL=http://localhost:3000
CRAWL_CALLBACK_URL=http://localhost:3000/api/crawl-results
